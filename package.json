{
  "name": "digital-legacy-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "check": "biome check .",
    "typecheck": "corepack pnpm --filter @dls/web typegen && tsc -b",
    "test:unit": "vitest run --config vitest.workspace.ts --project unit",
    "test:email": "vitest run --config vitest.workspace.ts --project email-rendering",
    "test:integration": "vitest run --config vitest.workspace.ts --project integration",
    "test:migrations": "node node_modules/vitest/vitest.mjs run --config vitest.workspace.ts --project integration tests/integration/migrations.test.ts",
    "test:concurrency": "node node_modules/vitest/vitest.mjs run --config vitest.config.ts tests/concurrency",
    "test:publication-crash-matrix": "node node_modules/vitest/vitest.mjs run --config vitest.faults.config.ts tests/faults/publication-crash-matrix.test.ts",
    "test:crypto": "vitest run --config vitest.workspace.ts --project crypto",
    "test:storage": "vitest run --config vitest.workspace.ts --project storage",
    "test:storage:filesystem": "node node_modules/vitest/vitest.mjs run --config vitest.workspace.ts --project storage packages/storage/src/object-key.test.ts packages/storage/src/archive/zip-inspector.test.ts packages/storage/src/filesystem/filesystem-storage.test.ts packages/storage/src/storage-factory.test.ts",
    "test:e2e": "node tests/e2e/run.mjs tests/e2e/contact-workflow.spec.ts tests/e2e/scenario-isolation.spec.ts",
    "test:full-stack-e2e": "node node_modules/@playwright/test/cli.js test --config tests/e2e/playwright.config.ts",
    "test:visual": "node tests/e2e/run.mjs tests/visual",
    "test:a11y": "node tests/e2e/run.mjs tests/accessibility",
    "test:browser-security": "node tests/e2e/run.mjs --production tests/security/browser-secrets.spec.ts tests/security/csp.spec.ts",
    "test:ui-gates": "node tests/e2e/run.mjs tests/visual tests/accessibility tests/security/browser-secrets.spec.ts tests/security/csp.spec.ts",
    "test:security": "vitest run --config vitest.workspace.ts --project security --passWithNoTests",
    "test:deployment": "vitest run --config vitest.workspace.ts --project deployment",
    "test:production-compose": "node node_modules/vitest/vitest.mjs run --config vitest.workspace.ts --project deployment tests/deployment/production-compose.test.ts",
    "build": "corepack pnpm --recursive --if-present run build",
    "openapi:generate": "corepack pnpm --filter @dls/api openapi:generate && corepack pnpm --filter @dls/contracts openapi:generate",
    "openapi:check": "corepack pnpm --filter @dls/api openapi:check && corepack pnpm --filter @dls/contracts openapi:check",
    "acceptance": "node ops/scripts/run-acceptance.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1103.0",
    "@dls/storage": "workspace:*",
    "nodemailer": "9.0.5",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.15.5",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "17.4.2",
    "tsx": "4.23.5",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
