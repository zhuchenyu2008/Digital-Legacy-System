          "vaultId",
          "shareGenerationId",
          "cipherAlgorithm",
          "streamHeader",
          "encryptedSize",
          "ciphertextSha256",
          "dekEnvelope",
          "dekEnvelopeNonce",
          "dekEnvelopeAlgorithm",
          "dekEnvelopeProtocolVersion",
          "dekEnvelopeAadHash",
          "manifestCiphertext",
          "manifestNonce",
          "manifestAlgorithm",
          "manifestAadHash",
