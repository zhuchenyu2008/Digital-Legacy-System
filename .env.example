NODE_ENV=development
PUBLIC_BASE_URL=http://localhost
DATABASE_URL=postgresql://dls_api:development@postgres:5432/dls

STORAGE_DRIVER=filesystem
STORAGE_PRIVATE_ROOT=/var/lib/dls/objects/private
STORAGE_STAGING_ROOT=/var/lib/dls/objects/staging
STORAGE_PUBLIC_ROOT=/var/lib/dls/objects/public

MAIL_TRANSPORT_URL=smtp://mailpit:1025
MAIL_FROM=Digital Legacy System <no-reply@dls.local>

SESSION_SECRET=
TOKEN_PEPPER=
TRUSTED_PROXY_CIDRS=172.16.0.0/12
WORKER_HEARTBEAT_STALE_MS=90000
RATE_LIMIT_OWNER_WINDOW_MS=60000
RATE_LIMIT_OWNER_MAX_ATTEMPTS=10
RATE_LIMIT_CONTACT_WINDOW_MS=60000
RATE_LIMIT_CONTACT_MAX_ATTEMPTS=10
RATE_LIMIT_RECOVERY_WINDOW_MS=60000
RATE_LIMIT_RECOVERY_MAX_ATTEMPTS=5
RATE_LIMIT_TOKEN_WINDOW_MS=60000
RATE_LIMIT_TOKEN_MAX_ATTEMPTS=20
DEBUG=false

# Key material is intentionally absent. Load only the owning process's files;
# see docs/operations/stage-key-capabilities.md.
DLS_RELEASE_INGRESS_KEY_VERSION=1
DLS_RECOVERY_INGRESS_KEY_VERSION=1
DLS_RELEASE_STAGE_KEY_VERSION=1
DLS_RECOVERY_STAGE_KEY_VERSION=1

# Required only when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_PRIVATE_BUCKET=
S3_PUBLIC_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
