NODE_ENV=development
PUBLIC_BASE_URL=http://localhost
DATABASE_URL=postgresql://dls_api:development@postgres:5432/dls

STORAGE_DRIVER=filesystem
STORAGE_PRIVATE_ROOT=/var/lib/dls/objects/private
STORAGE_STAGING_ROOT=/var/lib/dls/objects/staging
STORAGE_PUBLIC_ROOT=/var/lib/dls/objects/public

MAIL_TRANSPORT_URL=smtp://mailpit:1025
MAIL_FROM=Digital Legacy System <no-reply@dls.local>

SESSION_SECRET=
TOKEN_PEPPER=
TRUSTED_PROXY_HOPS=1
DEBUG=false

# Required only when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_PRIVATE_BUCKET=
S3_PUBLIC_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
